# Docker Compose settings for the local databases. Copy to `.env` and set a password.
# The backend also reads this file, so the same values build its database URL
# unless AGENTOS_DATABASE_URL is set in backend/.env.
AGENTOS_PG_USER=agentos
AGENTOS_PG_PASSWORD=change-me
AGENTOS_PG_DB=agentos
# 5433 avoids clashing with a PostgreSQL already installed on the host (5432).
AGENTOS_PG_PORT=5433
AGENTOS_QDRANT_PORT=6333
