# Required for real runs. Never commit your real .env file.
ANTHROPIC_API_KEY=

# Model used by all three agents (centralized in config.py).
# claude-sonnet-5-5 ($2/$10 per MTok) is a good cost/quality balance;
# claude-opus-5-5 ($4/$20) is stronger; claude-haiku-5-5 is cheapest
# (set AGENTOS_SEARCH_TOOL_VERSION=web_search_20250305 if you use Haiku for search).
AGENTOS_MODEL=claude-sonnet-5-5
AGENTOS_SEARCH_MODEL=claude-sonnet-5-5

# Reasoning effort per agent: low | medium | high | xhigh | max
AGENTOS_EFFORT_MANAGER=low
AGENTOS_EFFORT_RESEARCHER=low
AGENTOS_EFFORT_REVIEWER=medium

# Web search provider: "anthropic" (Claude server-side web search, uses ANTHROPIC_API_KEY;
# web search must be enabled for your org in the Claude Console) or "tavily".
AGENTOS_SEARCH_PROVIDER=anthropic
AGENTOS_SEARCH_TOOL_VERSION=web_search_20260209
TAVILY_API_KEY=

# Workflow bounds
AGENTOS_MAX_REVISIONS=2
AGENTOS_MAX_QUERIES_INITIAL=4
AGENTOS_MAX_QUERIES_FOLLOWUP=3

# Server-side refusal fallback (beta). Disabled automatically if the API rejects it.
AGENTOS_REFUSAL_FALLBACK=true

# Explicitly labeled scripted demo mode (no Claude calls, synthetic content).
AGENTOS_ENABLE_DEMO=true

# Uploads, JSONL event logs and Markdown reports are written here.
AGENTOS_DATA_DIR=./data
AGENTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Persistence ----------
# Leave unset locally: the URL is built from the Compose settings in the repo-root .env
# (AGENTOS_PG_USER / AGENTOS_PG_PASSWORD / AGENTOS_PG_DB / AGENTOS_PG_PORT).
# Set it for managed PostgreSQL, e.g. postgresql+psycopg://user:pass@host:5432/agentos?sslmode=require
AGENTOS_DATABASE_URL=
# Single local workspace until authentication exists. All queries are filtered by it.
AGENTOS_WORKSPACE_ID=default

# ---------- Knowledge Library (RAG) ----------
AGENTOS_QDRANT_URL=http://127.0.0.1:6333
# Required for managed Qdrant (Qdrant Cloud); not used by the local container.
AGENTOS_QDRANT_API_KEY=
AGENTOS_QDRANT_COLLECTION_PREFIX=agentos_chunks
# Local Sentence Transformers model (downloaded once from Hugging Face, ~90 MB).
# Changing the model creates a new Qdrant collection; existing documents must be reindexed.
AGENTOS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AGENTOS_EMBEDDING_DEVICE=cpu
# Chunking, in characters.
AGENTOS_CHUNK_SIZE=1000
AGENTOS_CHUNK_OVERLAP=150
AGENTOS_MAX_UPLOAD_MB=20
AGENTOS_MAX_PDF_PAGES=1000
AGENTOS_INGEST_CONCURRENCY=1
AGENTOS_MAX_PENDING_DOCUMENTS=50
# Retrieval: passages per query, and a cosine-similarity floor (not a confidence value).
AGENTOS_RAG_TOP_K=5
AGENTOS_RAG_MIN_SCORE=0.2
AGENTOS_MAX_DOC_QUERIES=4
